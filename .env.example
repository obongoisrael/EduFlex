# Copy this file to .env and fill in the values. Never commit .env.

# Claude API key for AI features (roadmap generation). Get one at https://console.anthropic.com
# Leave empty to run without AI — roadmaps then use the built-in templates.
ANTHROPIC_API_KEY=

# Long random string used to sign login sessions (required in production).
SESSION_SECRET=

# Optional: monthly AI roadmap generations per student (defaults: free 3, Plus 30).
# EDUFLEX_AI_FREE_LIMIT=3
# EDUFLEX_AI_PLUS_LIMIT=30

# ---- Email (verification + password reset links) ----
# Any SMTP provider works, e.g. Gmail (smtp.gmail.com, port 587, with an App Password),
# Brevo, SendGrid or Mailgun. Leave SMTP_HOST empty in development: emails are then
# printed in the server console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EduFlex <no-reply@yourdomain.com>"

# Public address of the app, used in email links (e.g. https://eduflex.example.com).
# Defaults to the address the request came in on.
APP_URL=

# Extra allowed school email domains, comma-separated, for institutions that don't use
# .edu / .ac.xx addresses (subdomains are included automatically).
# EDUFLEX_EMAIL_DOMAINS=myschool.org

# ---- Sign in with Google ----
# Create an OAuth client (type "Web application") at console.cloud.google.com → APIs & Services → Credentials.
# Authorized redirect URI:  <APP_URL>/api/auth/google/callback
#   e.g. http://localhost:3000/api/auth/google/callback
# The "Continue with Google" button appears automatically once both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to 1 to accept only university/college emails (.ac.ke, .edu, …). Default: any email.
EDUFLEX_REQUIRE_EDU_EMAIL=

# ---- Email over HTTPS with Brevo (use on Render's free plan, which blocks SMTP) ----
# brevo.com → SMTP & API → API Keys. MAIL_FROM must be a sender verified in Brevo.
# When set, Brevo is used instead of SMTP.
BREVO_API_KEY=

# ---- Database backup with Litestream (only for hosting WITHOUT a persistent disk) ----
# S3-compatible bucket, e.g. Cloudflare R2:
#   LITESTREAM_REPLICA_URL=s3://eduflex-backup/db?endpoint=https://<account-id>.r2.cloudflarestorage.com&region=auto
LITESTREAM_REPLICA_URL=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Owner admins: these emails (comma-separated) become admins when they sign in with a
# confirmed email. Use on hosts without a shell for `npm run make-admin` (e.g. Render free).
EDUFLEX_ADMIN_EMAILS=
